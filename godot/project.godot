; Polderrace 3D - Godot version (a port of polderrace-3d.html, see PLAN.md)

config_version=5

[application]

config/name="Polderrace 3D"
config/description="Arcaderacen over dijk, door dorp en langs duin."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

G="*res://scripts/core/globals.gd"
Trk="*res://scripts/track/track.gd"
Sfx="*res://scripts/game/sfx.gd"
Game="*res://scripts/game/game.gd"
Net="*res://scripts/net/net.gd"
Hud="*res://scripts/ui/hud.gd"
Champ="*res://scripts/game/champ.gd"
Career="*res://scripts/game/career.gd"
Ach="*res://scripts/game/ach.gd"
Menu="*res://scripts/ui/menu.gd"
NetUi="*res://scripts/ui/net_ui.gd"
Rep="*res://scripts/game/replay.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=3

[shader_globals]

pr_hemi_sky={
"type": "vec4",
"value": Vector4(0.691, 0.716, 0.75, 0)
}
pr_hemi_ground={
"type": "vec4",
"value": Vector4(0.278, 0.355, 0.196, 0)
}
pr_sun={
"type": "vec4",
"value": Vector4(0.95, 0.894, 0.789, 1)
}
pr_sun_dir={
"type": "vec4",
"value": Vector4(-0.455, 0.826, 0.331, 0)
}
pr_fog={
"type": "vec4",
"value": Vector4(0.863, 0.839, 0.761, 0)
}
pr_fog_range={
"type": "vec4",
"value": Vector4(160, 1150, 0, 0)
}
